<?xml version="1.0" encoding="UTF-8"?>
<!--
  Approved public URLs only. Five entries: the landing page and the four public
  corporate pages (/about, /contact, /privacy, /terms). Farmer onboarding,
  authentication, operational and evidence surfaces are out of scope by policy,
  not by omission.

  This file and the indexability register in src/lib/publicPageMetadata.ts are
  two halves of one decision and must agree. The register marks exactly these
  five pages `index,follow`; publicPageMetadata.test.ts reads this file and
  fails if the two lists diverge, so a page cannot be published here without
  the register saying it may be, and cannot be approved there without appearing
  here.

  The host is www.ddpbrokerage.com. The apex 308-redirects to www, so www is the
  canonical host; every <loc> must use it or a crawler is pointed at a redirect.

  No <lastmod>. A hand-maintained timestamp goes stale silently and a wrong one
  is worse than an absent one.

  Like robots.txt, this must be a static file: without it the vercel.json SPA
  rewrite serves /sitemap.xml as 200 text/html.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.ddpbrokerage.com/</loc>
  </url>
  <url>
    <loc>https://www.ddpbrokerage.com/about</loc>
  </url>
  <url>
    <loc>https://www.ddpbrokerage.com/contact</loc>
  </url>
  <url>
    <loc>https://www.ddpbrokerage.com/privacy</loc>
  </url>
  <url>
    <loc>https://www.ddpbrokerage.com/terms</loc>
  </url>
</urlset>
