{
  "name": "ddp-inventory-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && npm run prerender",
    "ci:runtime": "node scripts/disposable-pg/run-migration-harness.mjs --all --ci",
    "ci:verify": "npm run security:sql && npm test && tsc -b && npm run lint && npm run build",
    "dev": "vite",
    "lint": "eslint .",
    "prebuild": "node scripts/validate-hosted-supabase-config.mjs && node scripts/generate-version.js",
    "prerender": "vite build --ssr src/prerender/entry.tsx --outDir dist-ssr && node scripts/prerender-public-routes.mjs",
    "preview": "vite preview",
    "security:sql": "node scripts/check-security-migrations.mjs",
    "security:staging": "node scripts/run-staging-security-tests.mjs",
    "test": "vitest run",
    "verify:ledger-identity": "node scripts/check-ledger-self-identity.mjs",
    "verify:migration": "node scripts/disposable-pg/run-migration-harness.mjs",
    "verify:migration-collisions": "node scripts/audit-001-check-migration-collisions.mjs",
    "verify:migration-numbers": "node scripts/check-migration-numbers.mjs",
    "verify:migrations": "npm run verify:migration-numbers && npm run verify:migration-collisions && npm run verify:ledger-identity && npm run verify:rollback-symmetry",
    "verify:prerender": "node scripts/verify-prerender-deployed.mjs",
    "verify:rollback-symmetry": "node scripts/check-rollback-symmetry.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10"
  }
}
