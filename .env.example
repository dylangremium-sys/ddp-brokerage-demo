# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env or .env.local — they are in .gitignore.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ─── Server-only (Vercel Function: api/compliance/ai-summary) ───────────────
# These are NEVER exposed to the browser — no VITE_ prefix. Set them as Vercel
# Environment Variables (Production/Preview), not in the client bundle. The
# secure AI draft-summary endpoint fails closed (provider_unconfigured) when the
# AI provider key is absent, so the feature is simply unavailable until set.
#
# Used to verify the caller's Supabase session token and read their own profile
# row (RLS enforced). No service-role key is used or supported.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
#
# AI provider (Anthropic Messages API, called over direct HTTPS — no SDK).
ANTHROPIC_API_KEY=your-server-only-anthropic-key-here
AI_SUMMARY_MODEL=claude-opus-4-8
# Optional overrides:
# AI_SUMMARY_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01
